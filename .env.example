# ─────────────────────────────────────────────
#  School Enquiry Chatbot — Environment Configuration
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Supabase  (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — server-side only, never expose it in browser code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Panel (change these before going live)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# School Details (used in chatbot replies and on the website)
SCHOOL_NAME=Greenfield Public School
SCHOOL_PHONE=+91-20-0000-0000
SCHOOL_EMAIL=admissions@greenfieldschool.edu.in
SCHOOL_WEBSITE=https://www.greenfieldschool.edu.in
SCHOOL_ADDRESS=School Road, Pune, Maharashtra 411001

# Chat Settings
MAX_CHAT_HISTORY=100
CONFIDENCE_THRESHOLD=0.35
# Below this confidence, the student is offered a live chat with an admin
LIVE_CHAT_THRESHOLD=0.25
